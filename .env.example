# API
NODE_ENV=development
PORT=4001
CORS_ORIGINS=http://localhost:4200,http://localhost:4000

# Auth del BFF (Express)
JWT_SECRET=cambia-esto-con-openssl-rand-hex-32
AUTH_COOKIE_NAME=cms_session
AUTH_TOKEN_TTL_HOURS=8
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
# Genera el hash con: npm run hash-password -w @cms/api -- "tu-password"
ADMIN_PASSWORD_HASH=

# WordPress (backend headless, no exponer a internet)
WP_URL=https://cms.example.com
WP_USER=api-user
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Ruta de la API REST. Vacio = autodeteccion (wp-json o index.php/wp-json)
WP_REST_PATH=
WP_API=rest

# WPGraphQL (opcional, si WP_API=graphql)
WP_GRAPHQL_URL=https://cms.example.com/graphql

# Infra
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://cms:cms@localhost:5432/cms
