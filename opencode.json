{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "docs/context/PROJECT_STATE.md",
    "docs/context/CONVENTIONS.md",
    "docs/context/DECISIONS.md",
    "docs/context/HANDOFF.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "sudo *": "deny",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask"
    },
    "edit": {
      "*": "allow",
      ".env": "ask",
      "**/.env": "ask",
      "package-lock.json": "ask",
      "**/package-lock.json": "ask"
    }
  }
}
